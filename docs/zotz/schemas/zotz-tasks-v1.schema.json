{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "zotz-tasks/v1"
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "logoUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "url": {
          "type": "string",
          "maxLength": 2048
        },
        "taskIdPattern": {
          "type": "string",
          "maxLength": 200
        },
        "fields": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "type": {
                    "type": "string",
                    "const": "text"
                  }
                },
                "required": ["name", "type"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "type": {
                    "type": "string",
                    "const": "number"
                  }
                },
                "required": ["name", "type"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "type": {
                    "type": "string",
                    "const": "date"
                  }
                },
                "required": ["name", "type"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "type": {
                    "type": "string",
                    "const": "single-select"
                  },
                  "options": {
                    "minItems": 1,
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "color": {
                          "type": "string",
                          "enum": [
                            "GRAY",
                            "BLUE",
                            "GREEN",
                            "YELLOW",
                            "ORANGE",
                            "RED",
                            "PINK",
                            "PURPLE"
                          ]
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 500
                        },
                        "category": {
                          "type": "string",
                          "enum": ["todo", "in-progress", "done"]
                        }
                      },
                      "required": ["id", "name"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["name", "type", "options"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "type": {
                    "type": "string",
                    "const": "iteration"
                  },
                  "iterations": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "startDate": {
                          "type": "string",
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                        },
                        "duration": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 366
                        }
                      },
                      "required": ["id", "title", "startDate", "duration"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["name", "type", "iterations"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": ["id", "name", "fields"],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "actionsUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "actions": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50
          }
        }
      },
      "required": ["actionsUrl", "actions"],
      "additionalProperties": false
    },
    "tasks": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "default": "issue",
            "type": "string",
            "enum": ["issue", "draft"]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "state": {
            "type": "string",
            "enum": ["open", "closed"]
          },
          "project": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "avatarUrl": {
                "type": "string",
                "maxLength": 2048
              }
            },
            "required": ["id", "name"],
            "additionalProperties": false
          },
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "assignees": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "login": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "name": {
                  "type": "string",
                  "maxLength": 200
                },
                "avatarUrl": {
                  "type": "string",
                  "maxLength": 2048
                }
              },
              "required": ["login"],
              "additionalProperties": false
            }
          },
          "labels": {
            "default": [],
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "color": {
                  "type": "string",
                  "pattern": "^#?[0-9a-fA-F]{6}$"
                }
              },
              "required": ["name"],
              "additionalProperties": false
            }
          },
          "body": {
            "type": "string",
            "maxLength": 65536
          },
          "fieldValues": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1000
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "pullRequests": {
            "default": [],
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "repo": {
                  "type": "string",
                  "pattern": "^[\\w.-]+\\/[\\w.-]+$"
                },
                "number": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["repo", "number"],
              "additionalProperties": false
            }
          },
          "createdAt": {
            "type": "string",
            "maxLength": 64
          },
          "updatedAt": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "state",
          "assignees",
          "labels",
          "fieldValues",
          "pullRequests"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "source", "tasks"],
  "additionalProperties": false
}
